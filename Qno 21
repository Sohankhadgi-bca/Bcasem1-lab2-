#include <stdio.h>

int main() {
    int choice;
    float a, b, res;

    printf("1. Addition\n");
    printf("2. Subtraction\n");
    printf("3. Multiplication\n");
    printf("4. Division\n");
    printf("Enter your choice (1-4): ");
    scanf("%d", &choice);

    printf("Enter two numbers: ");
    scanf("%f %f", &a, &b);

    switch(choice) {
        case 1:
            res = a + b;
            printf("Result = %f\n", res);
            break;
        case 2:
            res = a - b;
            printf("Result = %f\n", res);
            break;
        case 3:
            res = a * b;
            printf("Result = %f\n", res);
            break;
        case 4:
            if (b != 0) {
                res = a / b;
                printf("Result = %f\n", res);
            } else {
                printf("Error: Division by zero\n");
            }
            break;
        default:
            printf("Invalid choice\n");
    }

    return 0;
}
