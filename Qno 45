#include <stdio.h>

int main(void) {
    int number, i, isPrime = 1;

    printf("Enter an integer: ");
    scanf("%d", &number);

    if (number < 2) {
        isPrime = 0;
    }
    for (i = 2; i <= number / i && isPrime; i++) {
        if (number % i == 0) {
            isPrime = 0;
        }
    }
    printf("%s\n", isPrime ? "Prime" : "Not prime");
    return 0;
}
