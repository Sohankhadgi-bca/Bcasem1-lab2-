#include <stdio.h>

int main(void) {
    int a, b, remainder;

    printf("Enter two integers: ");
    scanf("%d %d", &a, &b);

    if (a < 0) a = -a;
    if (b < 0) b = -b;
    while (b != 0) {
        remainder = a % b;
        a = b;
        b = remainder;
    }
    printf("GCD = %d\n", a);
    return 0;
}
