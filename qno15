#include <stdio.h>

int main() {
    float marks;

    printf("Enter marks: ");
    scanf("%f", &marks);

    if (marks >= 40) {
        if (marks >= 80) {
            printf("Result: Passed with Distinction\n");
        } else {
            printf("Result: Passed\n");
        }
    } else {
        printf("Result: Failed\n");
    }

    return 0;
}
