#include <stdio.h>

int main(void) {
    int n, i;
    unsigned long long first = 0, second = 1, next;

    printf("Enter the number of terms: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        printf("%llu", first);
        if (i < n) {
            printf(" ");
        }
        next = first + second;
        first = second;
        second = next;
    }
    printf("\n");
    return 0;
}
