#include <stdio.h>

int main(void) {
    int number, i, isPrime;

    for (number = 2; number <= 100; number++) {
        isPrime = 1;
        for (i = 2; i <= number / i; i++) {
            if (number % i == 0) {
                isPrime = 0;
                break;
            }
        }
        if (isPrime) {
            printf("%d ", number);
        }
    }
    printf("\n");
    return 0;
}
