#include <stdio.h>

int main() {
    int a;
    float b;
    char c;
    double d;

    printf("Enter an integer: ");
    scanf("%d", &a);

    printf("Enter a float: ");
    scanf("%f", &b);

    printf("Enter a character: ");
    scanf(" %c", &c);

    printf("Enter a double: ");
    scanf("%lf", &d);

    printf("Integer: %d\n", a);
    printf("Float: %f\n", b);
    printf("Character: %c\n", c);
    printf("Double: %lf\n", d);

    return 0;
}

