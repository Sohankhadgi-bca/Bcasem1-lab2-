#include <stdio.h>

int main(void) {
    long long number, value;
    int digits = 0, sum = 0, digit, i;

    printf("Enter a non-negative integer: ");
    scanf("%lld", &number);

    if (number < 0) {
        printf("Negative numbers are not Armstrong numbers in this program.\n");
        return 0;
    }
    value = number;
    do {
        digits++;
        value /= 10;
    } while (value != 0);

    value = number;
    do {
        digit = (int)(value % 10);
        int power = 1;
        for (i = 0; i < digits; i++) {
            power *= digit;
        }
        sum += power;
        value /= 10;
    } while (value != 0);

    printf("%s\n", (number == sum) ? "Armstrong number" : "Not an Armstrong number");
    return 0;
}
